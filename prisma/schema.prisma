generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActionType {
  MEETING_TO_ADD
  NEEDS_RESPONSE
  REQUEST_PENDING
  SCHEDULE_MEETING
}

enum ActionStatus {
  OPEN
  DONE
  SNOOZED
  DISMISSED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  emailVerified     DateTime?
  image             String?
  onboardingDone    Boolean        @default(false)
  gmailHistoryId    String?
  gmailWatchExpiry  DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  accounts          Account[]
  sessions          Session[]
  emails            EmailMessage[]
  actionItems       ActionItem[]
  digests           DailyDigest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  refresh_token_expires_in Int?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailMessage {
  id           String   @id @default(cuid())
  userId       String
  gmailId      String
  threadId     String
  subject      String
  fromAddress  String
  fromName     String?
  snippet      String
  bodyText     String?
  receivedAt   DateTime
  isRead       Boolean  @default(false)
  hasReplied   Boolean  @default(false)
  labels       String   @default("[]")
  processedAt  DateTime?
  createdAt    DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItems  ActionItem[]

  @@unique([userId, gmailId])
  @@index([userId, receivedAt])
}

model ActionItem {
  id              String         @id @default(cuid())
  userId          String
  emailId         String?
  type            ActionType
  status          ActionStatus   @default(OPEN)
  priority        ActionPriority @default(MEDIUM)
  title           String
  summary         String
  suggestedAction String?
  dueHint         String?
  meetingStart    DateTime?
  meetingEnd      DateTime?
  meetingLocation String?
  attendees       String         @default("[]")
  calendarEventId String?
  snoozedUntil    DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email EmailMessage? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([userId, status, type])
  @@index([userId, priority])
}

model DailyDigest {
  id          String   @id @default(cuid())
  userId      String
  digestDate  DateTime
  summary     String
  actionCount Int
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDate])
}
